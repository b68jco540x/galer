{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "tg-rich-messages": ["./tg-rich-messages/src/rich.ts"]
    }
  },
  "include": ["src/**/*", "tg-rich-messages/src/**/*"]
}
